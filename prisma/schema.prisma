generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
    id String @id @default(cuid())
    email String @unique
    password String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model File {
    id String @id @default(cuid())
    userId String
    name String
    url String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
